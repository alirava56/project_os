# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Required only to create first owner. Remove after setup.
PROJECTOS_SETUP_TOKEN=
# Keep path on private disk; do not place DB inside public/ or commit it.
PROJECTOS_DB_PATH=./local-data/projectos.sqlite
# Production unsafe-method requests fail closed unless the canonical HTTPS origin is declared.
# Must equal the browser Origin exactly, e.g. https://projectos.example.com
PROJECTOS_PUBLIC_ORIGIN=
# Use secure TLS before hosting outside localhost.
# Optional isolated PostgreSQL worker supervisor (set values in the worker process environment).
# PROJECTOS_LOCAL_REMINDER_DATABASE_URL=
# PROJECTOS_LOCAL_DELIVERY_DATABASE_URL=
# PROJECTOS_LOCAL_WORKER_INTERVAL_MS=30000
# PROJECTOS_TELEGRAM_PROJECT_DETAILS=disabled
# Optional server-side Vault scopes, in mount/prefix form.
# PROJECTOS_VAULT_PREFIXES=
# No real secrets or API keys belong in project data.

# Optional MFA encryption key (64 hex characters); retain securely, never commit.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PROJECTOS_MFA_ENCRYPTION_KEY=
# Set only for the encrypted backup process, never in client code.
PROJECTOS_BACKUP_PASSPHRASE=
# Optional, explicit HTTPS monitoring hosts; disabled unless configured.
PROJECTOS_MONITOR_HOSTS=

# Telegram notification opt-in. Keep tokens server-side, never in client bundles.
PROJECTOS_TELEGRAM_NOTIFICATIONS=disabled
PROJECTOS_TELEGRAM_BOT_TOKEN=
PROJECTOS_TELEGRAM_CHAT_ID=

# Optional read-only GitHub API access; use a fine-grained token scoped to listed repos.
PROJECTOS_GITHUB_TOKEN=
PROJECTOS_GITHUB_PROJECTS=

# Optional AI. Never enable external document transmission without explicit user consent.
PROJECTOS_AI_ENABLED=disabled
PROJECTOS_AI_SEND_DOCS=disabled
PROJECTOS_OPENAI_API_KEY=
PROJECTOS_AI_MODEL=

# Real backend. HTTPS is required outside a loopback-only private preview.
PROJECTOS_DATABASE_URL=
# Set to postgres on the web and worker services at cutover. A missing URL then fails closed.
PROJECTOS_DATABASE_MODE=
# Match the 32-byte hex key provisioned in PostgreSQL by the schema owner.
PROJECTOS_DB_SCOPE_KEY=
PROJECTOS_PG_CA=
PROJECTOS_REQUIRE_MFA=disabled
# Enable only behind a trusted proxy that replaces X-ProjectOS-Client-IP.
PROJECTOS_TRUST_CLIENT_IP=disabled

# Maintenance, backup, and restore. Do not set the restore URL to the live database.
PROJECTOS_PG_BIN=
PROJECTOS_RESTORE_URL=
PROJECTOS_NOTIFICATION_WORKSPACE=
PROJECTOS_REMINDER_OFFSETS=14,7,3,1,0
PROJECTOS_EMAIL_NOTIFICATIONS=disabled
PROJECTOS_RESEND_API_KEY=
PROJECTOS_EMAIL_FROM=
PROJECTOS_EMAIL_TO=

# Read-only metadata, scoped to an approved Workspace and KV v2 mounts.
PROJECTOS_VAULT_WORKSPACE=
PROJECTOS_VAULT_ORIGIN=
PROJECTOS_VAULT_MOUNTS=
PROJECTOS_VAULT_TOKEN=
PROJECTOS_GITHUB_WEBHOOK_SECRET=
PROJECTOS_MONITOR_WORKSPACE=
PROJECTOS_MONITOR_AGENT_TOKEN=
PROJECTOS_MONITOR_AGENT_RESOURCES=
PROJECTOS_AGENT_TARGET=
PROJECTOS_AGENT_RESOURCE_ID=
# Optional mounted path on the agent host. The path itself is not transmitted.
PROJECTOS_AGENT_DISK_PATH=
